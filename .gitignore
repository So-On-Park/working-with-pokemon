# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual envs ---
.venv/
venv/
env/

# --- Packaging / build ---
build/
dist/
installer_out/
*.egg-info/
*.egg

# PyInstaller build folder is ignored; the .spec file IS tracked because
# it defines the build recipe.
!PokemonBuddy.spec

# Distribution archives — they get rebuilt from sources, no need to track
PokemonBuddy-*.zip

# User-created backup zips (trayed "백업하기…" output) — personal data
pokemon-buddy-backup-*.zip
pokemon-buddy-backup-*

# Claude Code tool settings — personal, machine-specific
.claude/

# --- Test artifacts ---
.pytest_cache/
.coverage
htmlcov/

# --- Editors / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS junk ---
Thumbs.db
desktop.ini
.DS_Store

# --- Runtime ---
debug.log
*.log

# --- Media recordings (use git-lfs or separate hosting for these) ---
*.mp4
*.mov
*.webm
*.avi

# --- User data (never commit) ---
# Per-install SQLite DB with the user's caught pokemon, party state, etc.
# (Pattern is `dir/*` not `dir/` so the `!` re-include below works.)
data/*
!data/.gitkeep

# Sprite cache (downloaded from PokeAPI on demand) + per-user display
# scale + name caches.
assets/*
!assets/.gitkeep

# User-registered custom pokemon ARE tracked — they're authored content
# that should ship with the repo. At runtime they're copied into data/ (the
# update-safe user dir) by config.migrate_user_data(); the assets/ copies
# stay as the shipped read-only seed. PokeAPI downloads (4-digit dex_ids
# 0001-1999) stay ignored above by the broad `assets/*` rule.
!assets/custom_pokemon.json
!assets/9[0-9][0-9][0-9]_*.gif

# App / tray icon (메타몽 #0132) + file-type icons — build inputs, tracked.
!assets/icon.ico
!assets/pokeball.ico
!assets/scroll.ico

# Starter sprites shown in README — tracked so they render on GitHub.
!assets/0001_showdown.gif
!assets/0004_showdown.gif
!assets/0007_showdown.gif
!assets/0025_showdown.gif

# Extracted release folders
PokemonBuddy-*-win64/

# Local archive — backups, recordings, old releases moved out of the way.
# Personal / large / regenerable; never tracked.
_archive/
